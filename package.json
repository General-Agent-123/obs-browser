{
  "name": "obs-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "A local web interface for exploring Huawei Cloud OBS paths with obsutil.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "install:trajectory": "npm --prefix trajectory install",
    "build:trajectory": "npm --prefix trajectory run build",
    "dev:trajectory": "npm --prefix trajectory run dev"
  },
  "engines": {
    "node": ">=20"
  }
}
