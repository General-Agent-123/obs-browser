[Unit]
Description=OBS Explorer (obsutil web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data2/panjiacheng/obs-browser
EnvironmentFile=/data2/panjiacheng/obs-browser/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/node20/bin
ExecStart=/opt/node20/bin/node server.mjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
