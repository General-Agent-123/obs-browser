#!/usr/bin/env bash
# 部署钩子（post-receive）：把推送来的 main 分支检出到工作区目录，并重启服务。
# 安装方式见 docs/DEPLOY.md：配置 deploy.worktree 并软链到裸仓库 hooks/ 下。

# git 调用钩子时会注入 GIT_DIR / GIT_WORK_TREE（指向裸仓库），
# 会劫持后续对工作区的 git 操作，先清掉
unset GIT_DIR GIT_WORK_TREE

# 钩子执行时 $0 位于 <裸仓库>/hooks/ 下，取其父目录即裸仓库
BARE_REPO=$(cd "$(dirname "$0")/.." && pwd)

# 部署目标由裸仓库的 deploy.worktree 配置显式声明，缺省则拒绝部署
TARGET=$(git --git-dir="$BARE_REPO" config --get deploy.worktree)
if [ -z "$TARGET" ]; then
    echo "部署失败: 裸仓库未配置 deploy.worktree" >&2
    echo "请执行: git --git-dir=$BARE_REPO config deploy.worktree <工作区路径>" >&2
    exit 1
fi

git --work-tree="$TARGET" --git-dir="$BARE_REPO" checkout -f main || {
    echo "部署失败: checkout 出错" >&2
    exit 1
}

# 工作区若为普通 clone（origin 指向裸仓库），同步其分支指针，保持 git 状态干净
if [ -d "$TARGET/.git" ]; then
    if ! git -C "$TARGET" fetch -q origin || ! git -C "$TARGET" reset -q origin/main; then
        echo "警告: 工作区指针同步失败，可手动执行 git -C $TARGET reset origin/main" >&2
    fi
fi

echo "=========================================="
echo "  部署成功: 代码已自动更新至 $TARGET"
echo "=========================================="

# 本项目的服务是无状态的 Node 进程，检出后重启才会加载新代码。
# 服务由 systemd 托管时自动重启；否则提示手动重启。
SERVICE=$(git --git-dir="$BARE_REPO" config --get deploy.service)
if [ -n "$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then
    if systemctl restart "$SERVICE"; then
        echo "  服务已重启: $SERVICE"
    else
        echo "警告: systemctl restart $SERVICE 失败，请检查服务状态" >&2
    fi
else
    echo "  提示: 未配置 deploy.service，请手动重启 obs-browser 服务"
fi
