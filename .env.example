# Copy this file to .env and adjust as needed.
# .env is loaded automatically by `npm start`; existing shell variables win.

PORT=4318
HOST=127.0.0.1

# Initial folder shown by the web UI.
OBS_DEFAULT_PATH=obs://s3-asset-b-hd-cce-aifm-nlp-exp/task_data/261018/1018_frontend_scientific_mechanism_oc/task_configs/

# Optional: absolute path to the obsutil executable.
# OBSUTIL_BIN=/opt/homebrew/bin/obsutil

# Optional: custom obsutil config file. Defaults to ~/.obsutilconfig.
# OBSUTIL_CONFIG=/Users/you/.obsutilconfig

# Optional: shared access token. Leave empty for local-only use.
# When set, every page/API needs a login cookie; visit /login (or append
# ?token=<value> once) to sign in. Use a long random string.
# OBS_AUTH_TOKEN=

# Optional cache TTLs (ms). obsutil is a separate process per call, so a short
# in-process cache makes repeat navigation much faster; 0 disables the cache.
# OBS_LIST_CACHE_MS=30000
# OBS_LIST_STALE_MS=600000
# OBS_STAT_CACHE_MS=120000
# OBS_BUCKET_CACHE_MS=300000

# Optional limits.
# OBS_SEARCH_MAX_RESULTS=300
# OBS_SEARCH_MAX_SCAN=20000
# OBS_SEARCH_MAX_PAGES=200
# OBS_MAX_UPLOAD_BYTES=536870912
# OBS_BATCH_MAX_ITEMS=200
# OBS_BATCH_CONCURRENCY=4
